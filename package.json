{
  "name": "worship-word-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "vite-node scripts/generate-seo.ts",
    "seo:submit:indexnow": "node scripts/submit-indexnow.mjs",
    "email:configure": "node scripts/configure-supabase-email.mjs",
    "email:configure:apply": "node scripts/configure-supabase-email.mjs --apply",
    "build": "npm run seo:generate && tsc -b && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "catalogue:research": "python3 scripts/research-worship-catalogue.py",
    "catalogue:research:fallback": "python3 scripts/research-invidious-catalogue.py",
    "catalogue:import-research": "python3 scripts/import-research-candidates.py",
    "catalogue:report": "vite-node scripts/catalogue-report.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
