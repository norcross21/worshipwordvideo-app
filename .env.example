# Public Supabase browser configuration (never use a secret/service-role key here)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Vercel Function configuration. Never prefix either secret with VITE_.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Used only by `npm run email:configure:apply` after Resend approval.
SUPABASE_PROJECT_REF=your-project-reference
SUPABASE_ACCESS_TOKEN=your-supabase-management-access-token
RESEND_SMTP_PASSWORD=your-resend-api-key
